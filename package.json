{
  "name": "tracelock-inspection-instrument",
  "version": "1.1.0",
  "description": "TraceLock forensic card inspection instrument",
  "productName": "TraceLock Inspection Instrument",
  "main": "electron-main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir --win --x64",
    "test": "node --check electron-main.js && node --check preload.js && node --check session-store.js && node --check grbl-controller.js && node --check vision-bridge.js && node --check gpu-filters.js && node --check app.js && node tests/smoke-test.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tracelock.inspection",
    "productName": "TraceLock Inspection Instrument",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "session-store.js",
      "grbl-controller.js",
      "vision-bridge.js",
      "gpu-filters.js",
      "vision/**",
      "index.html",
      "app.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TraceLock Inspection Instrument",
      "artifactName": "TraceLock-Setup-${version}.${ext}"
    }
  }
}
